diff --git a/include/engine/community_models/fish_drama3/state_snapshot.h b/include/engine/community_models/fish_drama3/state_snapshot.h
new file mode 100644
index 0000000..112639d
--- /dev/null
+++ b/include/engine/community_models/fish_drama3/state_snapshot.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <ggml-alloc.h>
+#include <ggml-backend.h>
+#include <ggml.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace engine::models::fish_drama3 {
+
+// A device-resident copy of the leading bytes of a set of persistent runtime
+// tensors (KV-cache rows, recurrent states). Used by the per-voice prompt
+// prefix cache: save after prefilling a prefix, restore before prefilling a
+// request suffix. Copies stay on the tensors' backend (device-to-device on
+// CUDA); nothing is staged through host memory.
+class Drama3StateSnapshot {
+public:
+    struct Source {
+        ggml_tensor * tensor = nullptr;
+        size_t bytes = 0;  // leading bytes of `tensor` to keep
+    };
+
+    Drama3StateSnapshot(ggml_backend_t backend, const std::vector<Source> & sources, int64_t steps)
+        : backend_(backend), steps_(steps) {
+        if (backend_ == nullptr || sources.empty()) throw std::runtime_error("Drama 3 state snapshot requires a backend and sources");
+        const size_t overhead = ggml_tensor_overhead() * (sources.size() + 4);
+        view_ctx_.reset(ggml_init({overhead, nullptr, true}));
+        copy_ctx_.reset(ggml_init({overhead, nullptr, true}));
+        if (!view_ctx_ || !copy_ctx_) throw std::runtime_error("failed to initialize Drama 3 state snapshot contexts");
+        for (const auto & source : sources) {
+            if (source.tensor == nullptr || source.tensor->buffer == nullptr || source.tensor->data == nullptr) {
+                throw std::runtime_error("Drama 3 state snapshot source is not allocated");
+            }
+            const size_t element = ggml_type_size(source.tensor->type);
+            if (ggml_blck_size(source.tensor->type) != 1 || !ggml_is_contiguous(source.tensor) ||
+                source.bytes == 0 || source.bytes % element != 0 || source.bytes > ggml_nbytes(source.tensor)) {
+                throw std::runtime_error("Drama 3 state snapshot source range is invalid");
+            }
+            const int64_t elements = static_cast<int64_t>(source.bytes / element);
+            auto * view = ggml_view_1d(view_ctx_.get(), source.tensor, elements, 0);
+            view->data = nullptr;  // let ggml_backend_view_init bind buffer and address
+            if (ggml_backend_view_init(view) != GGML_STATUS_SUCCESS) throw std::runtime_error("failed to bind Drama 3 state snapshot view");
+            auto * copy = ggml_new_tensor_1d(copy_ctx_.get(), source.tensor->type, elements);
+            pairs_.push_back({view, copy});
+            bytes_ += source.bytes;
+        }
+        buffer_ = ggml_backend_alloc_ctx_tensors(copy_ctx_.get(), backend_);
+        if (buffer_ == nullptr) throw std::runtime_error("failed to allocate Drama 3 state snapshot buffer");
+        ggml_backend_synchronize(backend_);
+        for (const auto & pair : pairs_) ggml_backend_tensor_copy(pair.first, pair.second);
+    }
+
+    ~Drama3StateSnapshot() {
+        if (buffer_ != nullptr) ggml_backend_buffer_free(buffer_);
+    }
+
+    Drama3StateSnapshot(const Drama3StateSnapshot &) = delete;
+    Drama3StateSnapshot & operator=(const Drama3StateSnapshot &) = delete;
+
+    // Writes the saved bytes back into the original tensors. The caller must
+    // ensure those tensors are still the ones the snapshot was taken from.
+    void restore() const {
+        ggml_backend_synchronize(backend_);
+        for (const auto & pair : pairs_) ggml_backend_tensor_copy(pair.second, pair.first);
+    }
+
+    int64_t steps() const noexcept { return steps_; }
+    size_t bytes() const noexcept { return bytes_; }
+    ggml_backend_t backend() const noexcept { return backend_; }
+
+private:
+    struct ContextDeleter {
+        void operator()(ggml_context * context) const noexcept { if (context) ggml_free(context); }
+    };
+
+    ggml_backend_t backend_ = nullptr;
+    int64_t steps_ = 0;
+    size_t bytes_ = 0;
+    std::unique_ptr<ggml_context, ContextDeleter> view_ctx_;
+    std::unique_ptr<ggml_context, ContextDeleter> copy_ctx_;
+    ggml_backend_buffer_t buffer_ = nullptr;
+    std::vector<std::pair<ggml_tensor *, ggml_tensor *>> pairs_;
+};
+
+}  // namespace engine::models::fish_drama3
